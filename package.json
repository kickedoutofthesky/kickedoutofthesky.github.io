{
  "name": "kickedoutofthesky-store",
  "version": "1.0.0",
  "description": "Store frontend for Kicked Out of the Sky",
  "main": "index.js",
  "scripts": {
    "prepare": "husky install",
    "fetch-products": "node scripts/fetch-printful-products.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "lint": "eslint --ext .js .",
    "lint:fix": "eslint --ext .js . --fix",
    "format": "prettier --write . '!store/data/products.json'",
    "format:check": "prettier --check . '!store/data/products.json'"
  },
  "dependencies": {
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "babel-jest": "^26.6.3",
    "cypress": "^10.11.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^8.0.3",
    "jest": "^26.6.3",
    "lint-staged": "^12.5.0",
    "prettier": "^3.8.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
